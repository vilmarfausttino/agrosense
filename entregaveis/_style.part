:root{
  --verde:#085041; --verde-m:#1D9E75; --verde-l:#D6F0E7;
  --roxo:#7B2D8B; --roxo-l:#F4E8F9;
  --azul:#185FA5; --azul-l:#DCE9F7;
  --ambar:#BA7517; --ambar-l:#FEF3C7;
  --cz:#1F2937; --cm:#5F5E5A; --cc:#F1EFE8; --bg:#F8F7F5;
  --verm:#DC2626; --verm-l:#FEF2F2;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;color:var(--cz);background:#6b7280}
.slide{position:relative;width:297mm;height:167mm;overflow:hidden;background:var(--bg);
  page-break-after:always;break-after:page;margin:0 auto 8mm;box-shadow:0 4px 24px rgba(0,0,0,.35)}
.slide:last-child{page-break-after:auto;break-after:auto;margin-bottom:0}
.head{height:15mm;background:var(--verde);color:#fff;display:flex;align-items:center;
  justify-content:space-between;padding:0 12mm}
.head h2{font-size:15pt;font-weight:700}
.head .tag{font-size:9pt;opacity:.8;font-weight:400}
.body{padding:8mm 12mm;height:152mm;display:flex;flex-direction:column;justify-content:center}
.num{position:absolute;right:9mm;bottom:5mm;font-size:8pt;color:#9ca3af}
h3{font-size:12pt;color:var(--verde);margin-bottom:3mm}
p,li{font-size:10.5pt;line-height:1.5}
.sm{font-size:9.5pt}
.muted{color:var(--cm)}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:6px;padding:5mm}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:7mm}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6mm}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:5mm}
.kicker{font-size:8.5pt;text-transform:uppercase;letter-spacing:1.2px;color:var(--verde-m);
  font-weight:700;margin-bottom:2mm}
.big{font-size:26pt;font-weight:700;color:var(--verde);line-height:1.05}
ul{margin-left:5mm}
li{margin-bottom:1.5mm}
@page{size:297mm 167mm;margin:0}
@media print{body{background:#fff}.slide{margin:0;box-shadow:none}}
