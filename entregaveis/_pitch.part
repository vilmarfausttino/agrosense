/* elementos do pitch */
.stat{background:#fff;border:1px solid #e5e7eb;border-radius:6px;padding:5mm;text-align:center}
.stat .v{font-size:22pt;font-weight:700;color:var(--verde);line-height:1.05}
.stat .v.r{color:var(--verm)} .stat .v.b{color:var(--azul)} .stat .v.a{color:var(--ambar)}
.stat .l{font-size:8.5pt;color:var(--cm);margin-top:2mm;line-height:1.35}
.src{font-size:7.5pt;color:#9ca3af;margin-top:3mm}
table{width:100%;border-collapse:collapse;font-size:9.5pt}
th{background:var(--verde);color:#fff;text-align:left;padding:2.6mm 3mm;font-size:9pt;font-weight:700}
td{padding:2.4mm 3mm;border-bottom:1px solid #e5e7eb;background:#fff}
td.hi{background:var(--verde-l);font-weight:700;color:var(--verde)}
tr:last-child td{border-bottom:none}
.funnel{display:flex;flex-direction:column;align-items:center;gap:2mm}
.fstep{color:#fff;border-radius:4px;padding:3mm 4mm;text-align:center;font-size:9.5pt}
.fstep b{font-size:12pt;display:block}
.pipe{display:flex;align-items:stretch;gap:3mm}
.pstep{flex:1;background:#fff;border:1px solid #e5e7eb;border-top:3mm solid var(--verde-m);
  border-radius:5px;padding:4mm 3.5mm}
.pstep .n{font-size:8pt;font-weight:700;color:var(--verde-m)}
.pstep .t{font-size:10pt;font-weight:700;margin:1.5mm 0 2mm}
.pstep p{font-size:8.5pt;color:var(--cm);line-height:1.4}
.parrow{display:flex;align-items:center;color:var(--verde-m);font-size:14pt;font-weight:700}
.tl{display:flex;gap:0}
.tlc{flex:1;padding:0 4mm;border-left:2px solid var(--verde-m)}
.tlc .d{font-size:8.5pt;font-weight:700;color:var(--verde-m)}
.tlc .t{font-size:10.5pt;font-weight:700;margin:1.5mm 0 2mm}
.tlc p{font-size:8.8pt;color:var(--cm);line-height:1.4}
.ods{display:inline-block;background:var(--verde);color:#fff;font-size:8pt;font-weight:700;
  border-radius:3mm;padding:1.4mm 3.5mm;margin-right:2mm}
.member{background:#fff;border:1px solid #e5e7eb;border-radius:6px;padding:4mm}
.member .nm{font-size:10pt;font-weight:700;color:var(--verde)}
.member .rl{font-size:8pt;color:var(--verde-m);font-weight:700;margin:1mm 0 2mm;text-transform:uppercase;letter-spacing:.5px}
.member p{font-size:8.5pt;color:var(--cm);line-height:1.4}
.quote{font-size:15pt;line-height:1.45;color:var(--verde);font-weight:700}
